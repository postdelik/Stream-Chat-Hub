{
  "name": "stream-chat-hub",
  "version": "0.1.4",
  "description": "Stream Chat Hub beta",
  "main": "dist-main/main/main.js",
  "author": "postdelik",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "wait-on http://localhost:5173 && tsc -p tsconfig.main.json && electron .",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.2",
    "@vitejs/plugin-react": "^5.1.1",
    "fastify": "^5.6.2",
    "nanoid": "^5.1.6",
    "tmi.js": "^1.8.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^8.0.11",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.danila.streamchathub",
    "productName": "Stream Chat Hub",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-main/**/*",
      "package.json"
    ],
"win": {
  "target": [
    "nsis",
    "portable"
  ],
  "artifactName": "${productName}-${version}-${arch}.${ext}",
  "icon": "build/icon.ico",
  "signAndEditExecutable": false
},
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}